# Echoes — server-side configuration. Copy to .env.local. Never commit .env.local.

# Required: encrypts users' stored AI keys (AES-256-GCM via HKDF). Auto-generated into .env.local on first use if missing.
# Changing it makes all stored keys unreadable (users must re-enter them).
ECHOES_SECRET=

# Where users/sessions/encrypted keys are stored (JSON file). Default: ./.echoes-data
# ECHOES_DATA_DIR=

# Allow "Other (OpenAI-compatible)" base URLs on localhost/private networks (local models, tests). Keep off on public servers (SSRF).
# ECHOES_ALLOW_PRIVATE_BASEURL=1

# Optional keyed news APIs (server-side only) and their daily request caps
# NEWSDATA_API_KEY=        # https://newsdata.io/register
# NEWSDATA_DAILY_CAP=150
# CURRENTS_API_KEY=        # https://currentsapi.services/en/register
# CURRENTS_DAILY_CAP=300
# GUARDIAN_API_KEY=        # https://open-platform.theguardian.com/access/ (developer key = non-commercial)
# GUARDIAN_DAILY_CAP=400

# Optional: public URL (sent as HTTP-Referer to OpenRouter)
# ECHOES_PUBLIC_URL=https://example.com
